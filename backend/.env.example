# ============================================
#  PLANTILLA DE CONFIGURACION
# ============================================
# Copia este archivo, renombralo a ".env" y completa los valores
# con los datos de TU instalacion local de SQL Server.
# El archivo .env real NO se sube al repositorio (esta en .gitignore).

# Clave para firmar los tokens JWT. Para desarrollo local, cualquier texto sirve.
SECRET=cambiar_por_un_texto_secreto

# --- Conexion a SQL Server ---
# Nombre de la base (crearla en SQL Server Management Studio antes de arrancar).
DB_NAME=DulceEzeiza

# Usuario y contraseña de SQL Server (autenticacion SQL Server, no Windows).
DB_USER=dulce_user
DB_PASSWORD=cambiar_por_tu_password

# Donde corre el servidor de SQL Server. En local, localhost.
DB_HOST=localhost

# Nombre de la instancia. Si instalaste SQL Server Express, suele ser SQLEXPRESS.
DB_INSTANCE=SQLEXPRESS

# Dialecto de SQL para Sequelize. Para SQL Server va mssql.
DB_DIALECT=mssql

# Encriptacion de la conexion. En local van los dos en true
# (equivale a tildar "Trust server certificate" en SSMS).
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Puerto donde escucha el servidor de Node (NO es el puerto de la base).
PORT=8080
